# Replace these examples with your own database credentials.
# DATABASE_DRIVER defaults to neon when unset. Use postgres only for an
# isolated local PostgreSQL database; remove DATABASE_URL_POOLED in that mode.
DATABASE_DRIVER=neon

# Neon direct URL used by Drizzle Kit for migration commands.
DATABASE_URL=postgresql://clickmenu:replace-me@ep-example.us-east-2.aws.neon.tech/clickmenu?sslmode=require

# Neon pooled URL used by the Next.js application runtime.
DATABASE_URL_POOLED=postgresql://clickmenu:replace-me@ep-example-pooler.us-east-2.aws.neon.tech/clickmenu?sslmode=require

# Local alternative: set DATABASE_DRIVER=postgres, replace DATABASE_URL with
# your isolated local PostgreSQL URL, and remove/comment DATABASE_URL_POOLED.
# The application and migration command then use DATABASE_URL.

# Private Neon Object Storage bucket used for uploaded menu images.
AWS_ENDPOINT_URL_S3=https://example.storage.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Optional metadata base URL.
SITE_URL=http://localhost:3000

# Required for recoverable table-QR rotation. Generate a private 32-byte key;
# keep it stable across deployments and never expose it to client code.
TABLE_QR_RECOVERY_KEY=replace-with-a-random-32-byte-base64-secret

# Server-only AES-256-GCM key for recovering customer order tracking tokens.
# Generate locally with the command documented in docs/DEPLOYMENT_AND_RUNBOOK.md.
ORDER_TRACKING_RECOVERY_KEY=replace-with-a-random-32-byte-base64-secret

# Keep disabled. Set to exact lowercase true only in a prepared isolated test.
DINE_IN_ORDER_INTAKE_ENABLED=false
